@model List<Office>
@{
    ViewData["Title"] = "Адреси по градове";
    ViewData["Help"] = "admin-uslugi";
    Office form = ViewBag.Form;
    List<Institution> institutions = ViewBag.Institutions;
    string? city = ViewBag.City;
    int? institutionId = ViewBag.InstitutionId;
    string? myCity = ViewBag.MyCity;
}
<h1>Адреси по градове</h1>
<p class="text-muted">Адресът, телефонът и работното време на институциите във всеки град. Помощникът ги показва на хората от този град.
    Ако за някой град няма адрес, помощникът показва най-близкото място в картата.</p>

<div class="row g-4">
    <div class="col-xl-8">
        <form method="get" class="d-flex flex-wrap gap-2 mb-3" id="officeFilter">
            @if (myCity == null)
            {
                <select name="city" class="form-select" style="max-width: 14rem" aria-label="Град" onchange="this.form.requestSubmit()">
                    <option value="">Всички градове</option>
                    @foreach (var c in GuideCities.All.OrderBy(c => c.Name)) { <option value="@c.Name" selected="@(city == c.Name)">@c.Name</option> }
                </select>
            }
            <select name="institutionId" class="form-select" style="max-width: 22rem" aria-label="Институция" onchange="this.form.requestSubmit()">
                <option value="">Всички институции</option>
                @foreach (var i in institutions) { <option value="@i.Id" selected="@(institutionId == i.Id)">@i.Name</option> }
            </select>
            <noscript><button class="btn btn-outline-primary" type="submit">Покажи</button></noscript>
        </form>
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="officeTable">
                    <thead class="table-light"><tr><th>Град</th><th>Институция и адрес</th><th>Телефон</th><th></th></tr></thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="4" class="text-muted">@(city != null ? "За " + city + " още няма адреси. Помощникът показва мястото в картата." : "Още няма адреси.")</td></tr>
                        }
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@o.City</td>
                                <td><div class="fw-semibold">@o.Institution!.Name</div>
                                    <div>@o.Address</div>
                                    @if (!string.IsNullOrWhiteSpace(o.WorkingHours)) { <div class="small text-muted">@o.WorkingHours</div> }</td>
                                <td class="text-nowrap">@o.Phone</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@o.Id">Промени</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@o.Id" class="d-inline" onsubmit="return confirm('Да се изтрие ли адресът в @o.City?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <form method="post" asp-action="Create" class="aside-card" novalidate>
            <h2 class="h5 mb-3"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i> Нов адрес</h2>
            @{ ViewData["Prefix"] = "Form."; }
            <partial name="_Fields" model="form" view-data="ViewData" />
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Добави</button>
        </form>
    </div>
</div>
