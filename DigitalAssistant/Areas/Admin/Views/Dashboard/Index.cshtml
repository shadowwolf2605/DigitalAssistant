@inject DigitalAssistant.Data.AppDbContext Db
@{
    ViewData["Title"] = "Табло";
    ViewData["Help"] = "admin-vhod";
    var questions = (List<Question>)ViewBag.NewQuestions;
    var applications = (List<Application>)ViewBag.NewApplications;
    var messages = (List<Application>)ViewBag.NewMessages;
    int overdue = ViewBag.Overdue;
    var chart = (List<(DateTime Day, int Count)>)ViewBag.Chart;
    var max = Math.Max(1, chart.Max(c => c.Count));
    var maxDay = chart.First(c => c.Count == chart.Max(x => x.Count)).Day;
    var hour = DateTime.Now.Hour;
    var greeting = hour < 11 ? "Добро утро" : hour < 18 ? "Добър ден" : "Добър вечер";
    // Поздрав с първото име на служителя (ако е въведено)
    var fullName = Db.AdminUsers.Where(a => a.Username == User.Identity!.Name).Select(a => a.FullName).FirstOrDefault();
    // Главният администратор няма лично име – поздравът е без име
    var firstName = string.IsNullOrWhiteSpace(fullName) || fullName == "Главен администратор" ? null : fullName.Split(' ')[0];
    string[] dayNames = { "нд", "пн", "вт", "ср", "чт", "пт", "сб" };
}
<div class="admin-welcome">
    <h1 class="mb-1">@(firstName == null ? greeting : greeting + ", " + firstName)!</h1>
    <p class="text-muted mb-0">@DateTime.Today.ToString("dd.MM.yyyy") · Ето какво чака вашето внимание днес.</p>
</div>

<div class="row g-3 mb-4" data-stagger>
    <div class="col-6 col-xl-3 anim">
        <a class="stat-card text-decoration-none text-reset" data-tone="tone-0" asp-controller="Applications" asp-action="Index" asp-route-status="Submitted">
            <span class="cat-icon tone-0"><i class="bi bi-inboxes" aria-hidden="true"></i></span>
            <div><div class="value">@applications.Count</div><div class="label">@(applications.Count == 1 ? "ново заявление" : "нови заявления")</div></div>
        </a>
    </div>
    <div class="col-6 col-xl-3 anim">
        <a class="stat-card text-decoration-none text-reset" data-tone="tone-4" asp-controller="Applications" asp-action="Index" asp-route-status="NeedsDocuments">
            <span class="cat-icon tone-4"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            <div><div class="value">@ViewBag.WaitingDocuments</div><div class="label">@((int)ViewBag.WaitingDocuments == 1 ? "чака документи" : "чакат документи")</div></div>
        </a>
    </div>
    <div class="col-6 col-xl-3 anim">
        <a class="stat-card text-decoration-none text-reset" data-tone="tone-5" asp-controller="Questions" asp-action="Index">
            <span class="cat-icon tone-5"><i class="bi bi-question-circle" aria-hidden="true"></i></span>
            <div><div class="value">@questions.Count</div><div class="label">@(questions.Count == 1 ? "въпрос без отговор" : "въпроса без отговор")</div></div>
        </a>
    </div>
    <div class="col-6 col-xl-3 anim">
        <a class="stat-card text-decoration-none text-reset" data-tone="tone-2" asp-controller="Services" asp-action="Index">
            <span class="cat-icon tone-2"><i class="bi bi-grid" aria-hidden="true"></i></span>
            <div><div class="value">@ViewBag.ActiveServices</div><div class="label">@((int)ViewBag.ActiveServices == 1 ? "активна услуга" : "активни услуги") (@ViewBag.InactiveServices @((int)ViewBag.InactiveServices == 1 ? "неактивна" : "неактивни"))</div></div>
        </a>
    </div>
</div>

@if (messages.Count > 0)
{
    <div class="alert alert-primary anim" id="dashMessages">
        <div class="fw-semibold mb-1"><i class="bi bi-chat-square-text-fill me-1" aria-hidden="true"></i> Нови съобщения от граждани (@messages.Count)</div>
        <ul class="mb-0">
            @foreach (var a in messages.Take(5))
            {
                <li><a asp-controller="Applications" asp-action="Details" asp-route-id="@a.Id">№ @a.Number</a> – @a.Citizen!.FullName</li>
            }
        </ul>
    </div>
}
@if (overdue > 0)
{
    <div class="alert alert-warning anim" id="dashOverdue"><i class="bi bi-alarm me-1" aria-hidden="true"></i>
        @(overdue == 1 ? "1 заявление е с изтекъл срок и още не е готово." : $"{overdue} заявления са с изтекъл срок и още не са готови.")
        <a asp-controller="Applications" asp-action="Index" asp-route-overdue="true">Вижте закъснелите заявления</a>.</div>
}

<div class="row g-4">
    <div class="col-xl-7">
        <div class="info-card h-100 mb-0">
            <div class="d-flex justify-content-between align-items-start">
                <h2 class="mb-0"><i class="bi bi-bar-chart" aria-hidden="true"></i>Зададени въпроси за последните 14 дни</h2>
                <div class="text-end small text-muted">днес: <strong class="text-body">@ViewBag.QuestionsToday</strong><br />за 30 дни: <strong class="text-body">@ViewBag.QuestionsMonth</strong></div>
            </div>
            <div class="chart" id="questionsChart">
                <div class="chart-bars" role="img" aria-label="Брой въпроси по дни. Подробно в таблицата под графиката.">
                    @for (var i = 0; i < chart.Count; i++)
                    {
                        var c = chart[i];
                        var isToday = c.Day == DateTime.Today;
                        var label = isToday || c.Day == maxDay;
                        <div class="slot" tabindex="0" data-tip="@c.Day.ToString("dd.MM") (@dayNames[(int)c.Day.DayOfWeek]): @c.Count @(c.Count == 1 ? "въпрос" : "въпроса")">
                            <div class="bar @(isToday ? "today" : "")" style="--i:@i;height:@(c.Count * 100 / max)%">
                                @if (label) { <span>@c.Count</span> }
                            </div>
                        </div>
                    }
                </div>
                <div class="chart-axis">
                    @foreach (var c in chart)
                    {
                        <span>@if (c.Day == DateTime.Today) { <text>днес</text> } else { <b class="long fw-normal">@c.Day.ToString("dd.MM")</b><b class="short fw-normal">@c.Day.Day</b> }</span>
                    }
                </div>
                <div class="chart-tip" id="chartTip" hidden></div>
            </div>
            <details class="mt-3 small">
                <summary>Покажи като таблица</summary>
                <table class="table table-sm mt-2 mb-0">
                    <thead><tr><th>Дата</th><th class="text-end">Брой въпроси</th></tr></thead>
                    <tbody>@foreach (var c in chart) { <tr><td>@c.Day.ToString("dd.MM.yyyy")</td><td class="text-end">@c.Count</td></tr> }</tbody>
                </table>
            </details>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="info-card h-100 mb-0">
            <h2><i class="bi bi-inboxes" aria-hidden="true"></i>Нови заявления</h2>
            @if (applications.Count == 0)
            {
                <p class="text-muted mb-0">Няма нови заявления.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var a in applications.Take(6))
                    {
                        <a class="list-group-item list-group-item-action px-0 d-flex justify-content-between gap-2" asp-controller="Applications" asp-action="Details" asp-route-id="@a.Id">
                            <span><strong>№ @a.Number</strong> · @a.Service!.Name<span class="d-block small text-muted">@a.Citizen!.FullName</span></span>
                            <span class="small text-muted text-nowrap">@a.UpdatedAt.ToString("dd.MM HH:mm")</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-4">
    @if (questions.Count > 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
            <strong>Имате @questions.Count @(questions.Count == 1 ? "нов въпрос" : "нови въпроса") без отговор.</strong>
            Отворете въпроса, за да добавите ключови думи към подходяща услуга.
        </div>
        <div class="table-wrap">
            <div class="list-group list-group-flush">
                @foreach (var q in questions)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between" asp-controller="Questions" asp-action="Review" asp-route-id="@q.Id">
                        <span class="text-break" style="min-width: 0">„@q.Text“</span>
                        <span class="text-muted small text-nowrap ms-2">@q.AskedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i> Няма нови въпроси без отговор.</div>
    }
</div>

@section Scripts {
    <script>
        // Подсказка с датата и броя при посочване на стълбче
        (function () {
            const chart = document.getElementById('questionsChart');
            const tip = document.getElementById('chartTip');
            function show(slot) {
                tip.textContent = slot.dataset.tip;
                tip.hidden = false;
                const r = slot.getBoundingClientRect(), c = chart.getBoundingClientRect();
                tip.style.left = (r.left - c.left + r.width / 2) + 'px';
                tip.style.top = (slot.querySelector('.bar').getBoundingClientRect().top - c.top - 8) + 'px';
            }
            chart.querySelectorAll('.slot').forEach(s => {
                s.addEventListener('pointerenter', () => show(s));
                s.addEventListener('focus', () => show(s));
                s.addEventListener('pointerleave', () => tip.hidden = true);
                s.addEventListener('blur', () => tip.hidden = true);
            });
        })();
    </script>
}
