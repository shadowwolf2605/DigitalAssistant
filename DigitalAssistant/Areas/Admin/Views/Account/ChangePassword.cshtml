@model ChangePasswordModel
@{
    ViewData["Title"] = "Смяна на парола";
    ViewData["Help"] = "admin-vhod";
}
<div class="row">
    <div class="col-md-6 col-lg-4">
        <h1>Смяна на парола</h1>
        @if (TempData["Info"] is string info) { <div class="alert alert-warning" id="mustChange"><i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i> @info</div> }
        <form asp-action="ChangePassword" method="post" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="small"></span>
            </div>
            <button class="btn btn-primary" type="submit">Смени паролата</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
