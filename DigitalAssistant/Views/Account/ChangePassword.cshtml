@model ChangePasswordModel
@{
    ViewData["Title"] = "Смяна на парола";
    ViewData["Help"] = "profil";
}
<section class="hero page-hero pb-5">
    <span class="blob blob-1"></span><span class="blob blob-3"></span>
    <div class="container text-center pb-5">
        <h1 class="anim" style="--i:0">Смяна на парола</h1>
        <p class="lead anim mx-auto" style="--i:1">Новата парола трябва да е поне 8 знака.</p>
    </div>
</section>
<div class="container">
    <div class="auth-wrap anim-pop" style="max-width: 440px">
        <form method="post" class="form-card" novalidate>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="small"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-key me-1" aria-hidden="true"></i> Смени паролата</button>
            <p class="text-center mt-3 mb-0"><a asp-action="Profile"><i class="bi bi-arrow-left" aria-hidden="true"></i> Към профила</a></p>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
