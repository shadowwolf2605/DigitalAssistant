@model ResetPasswordModel
@{
    ViewData["Title"] = "Нова парола";
    ViewData["Help"] = "registracia";
    bool valid = ViewBag.Valid;
}
<section class="hero page-hero pb-5">
    <span class="blob blob-1"></span><span class="blob blob-2"></span>
    <div class="container text-center pb-5">
        <h1 class="anim" style="--i:0">Нова парола</h1>
        <p class="lead anim mx-auto" style="--i:1">Паролата трябва да е поне 8 знака.</p>
    </div>
</section>

<div class="container">
    <div class="auth-wrap anim-pop" style="max-width: 440px">
        @if (!valid)
        {
            <div class="form-card text-center">
                <p class="mb-3"><i class="bi bi-x-octagon text-danger me-1" aria-hidden="true"></i> Връзката е използвана или е изтекла.</p>
                <a class="btn btn-primary" asp-action="ForgotPassword">Поискай нова връзка</a>
            </div>
        }
        else
        {
            <form method="post" class="form-card" novalidate>
                <input type="hidden" asp-for="Token" />
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-key me-1" aria-hidden="true"></i> Запази паролата</button>
            </form>
        }
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
