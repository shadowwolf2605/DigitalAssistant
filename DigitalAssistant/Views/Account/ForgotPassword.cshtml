@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забравена парола";
    ViewData["Help"] = "registracia";
    var sent = ViewBag.Sent as string;
}
<section class="hero page-hero pb-5">
    <span class="blob blob-1"></span><span class="blob blob-3"></span>
    <div class="container text-center pb-5">
        <h1 class="anim" style="--i:0">Забравена парола</h1>
        <p class="lead anim mx-auto" style="--i:1">Напишете имейла на профила си. Ще ви изпратим връзка, от която да зададете нова парола.</p>
    </div>
</section>

<div class="container">
    <div class="auth-wrap anim-pop" style="max-width: 440px">
        @if (ViewBag.NoEmail == true)
        {
            <div class="alert alert-warning" id="noEmail"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                В тази пробна версия на сайта не се изпращат писма, затова паролата не може да се смени по имейл. Ако сте забравили паролата си, обърнете се към центъра.</div>
        }
        @if (sent != null)
        {
            <div class="alert alert-success" id="resetSent"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i>
                Ако има профил с имейл @sent, ще получите писмо с връзка за нова парола. Връзката важи 1 час.</div>
        }
        <form method="post" class="form-card" novalidate>
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="small"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-envelope me-1" aria-hidden="true"></i> Изпрати връзка</button>
            <p class="text-center mt-3 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left" aria-hidden="true"></i> Към входа</a></p>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
